{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2020"],
    "outDir": "./dist",
    "rootDir": "./",
    "strict": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    // paths resolve relative to this file; baseUrl is deprecated in TS 6 and removed in TS 7
    "paths": {
      "@/types/*": ["./types/*"],
      "@/utils/*": ["./utils/*"],
      "@/routes/*": ["./routes/*"]
    }
  },
  "ts-node": {
    "transpileOnly": true,
    "files": true,
    "require": ["tsconfig-paths/register"],
    "compilerOptions": {
      "module": "commonjs"
    }
  },
  "include": ["*.ts", "routes/**/*.ts", "utils/**/*.ts", "types/**/*.ts", "evals/**/*.ts", "scripts/**/*.ts"],
  "exclude": ["node_modules", "frontend", "public", "dist"]
}
