      {
        "name": "AI_CHAT_WEBHOOK_TOKEN",
        "label": "$t:playground.schema.webhookTokenLabel",
        "type": "input",
        "placeholder": "$t:playground.schema.webhookTokenPlaceholder",
        "help": "$t:playground.schema.webhookTokenHelp",
        "clearable": true,
        "inputType": "$handler:config.passwordToggle"
      },
      {
        "name": "AI_CHAT_WEBHOOK_EMAIL",
        "label": "$t:playground.schema.webhookEmailLabel",
        "type": "input",
        "placeholder": "$t:playground.schema.webhookEmailPlaceholder",
        "help": "$t:playground.schema.webhookEmailHelp",
        "clearable": true
      },
      {
        "name": "AI_CHAT_WEBHOOK_ALLOW_SIDE_EFFECTS",
        "label": "$t:playground.schema.webhookSideEffectsLabel",
        "type": "switch",
        "help": "$t:playground.schema.webhookSideEffectsHelp"
      }
    ]
  },
