[
  {
    "id": "config-weather",
    "label": "$t:playground.schema.tplLabelWeather",
    "category": "config",
    "fields": [
      {
        "name": "JUHE_WEATHER_KEY",
        "label": "$t:playground.schema.weatherApiKeyLabel",
        "type": "input",
        "placeholder": "$t:playground.schema.weatherApiKeyPlaceholder",
        "clearable": true,
        "inputType": "$handler:config.passwordToggle",
        "rules": [
          {
            "required": true,
            "message": "$t:playground.schema.weatherApiKeyRequired"
          }
        ]
      },
      {
        "name": "_selectedProvince",
        "label": "$t:playground.schema.weatherCityLabel",
        "type": "group",
        "rules": [
          {
            "required": true,
            "message": "$t:playground.schema.weatherCityRequired"
          }
        ],
        "children": [
          {
            "name": "_selectedProvince",
            "type": "select",
            "placeholder": "$t:playground.schema.weatherProvincePlaceholder",
            "clearable": true,
            "width": "160px",
            "options": "$handler:config.provinceOptions",
            "onChange": "$handler:config.onProvinceChange"
          },
          {
            "name": "WEATHER_CITY_NAME",
            "type": "select",
            "placeholder": "$t:playground.schema.weatherCityPlaceholder",
            "clearable": true,
            "disabled": "$handler:config.cityDisabled",
            "options": "$handler:config.cityOptions"
          }
        ]
      }
    ]
  },
  {
    "id": "config-almanac",
    "label": "$t:playground.schema.tplLabelAlmanac",
    "category": "config",
    "fields": [
      {
        "name": "JUHE_ALMANAC_KEY",
        "label": "$t:playground.schema.almanacApiKeyLabel",
        "type": "input",
        "placeholder": "$t:playground.schema.almanacApiKeyPlaceholder",
        "clearable": true,
        "inputType": "$handler:config.passwordToggle",
        "rules": [
          {
            "required": true,
            "message": "$t:playground.schema.almanacApiKeyRequired"
          }
        ]
      }
    ]
  },
  {
    "id": "config-horoscope",
    "label": "$t:playground.schema.tplLabelHoroscope",
    "category": "config",
    "fields": [
      {
        "name": "JUHE_HOROSCOPE_KEY",
        "label": "$t:playground.schema.horoscopeApiKeyLabel",
        "type": "input",
        "placeholder": "$t:playground.schema.horoscopeApiKeyPlaceholder",
        "clearable": true,
        "inputType": "$handler:config.passwordToggle",
        "rules": [
          {
            "required": true,
            "message": "$t:playground.schema.horoscopeApiKeyRequired"
          }
        ]
      }
    ]
  },
  {
    "id": "config-amap",
    "label": "$t:playground.schema.tplLabelAmap",
    "category": "config",
    "fields": [
      {
        "name": "AMAP_KEY",
        "label": "$t:playground.schema.amapKeyLabel",
        "type": "input",
        "placeholder": "$t:playground.schema.amapKeyPlaceholder",
        "clearable": true,
        "inputType": "$handler:config.passwordToggle",
        "rules": [
          {
            "required": true,
            "message": "$t:playground.schema.amapKeyRequired"
