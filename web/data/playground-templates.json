  {
    "id": "config-project",
    "label": "$t:playground.schema.tplLabelProject",
    "category": "config",
    "fields": [
      {
        "name": "PROJECT_DIR",
        "label": "$t:playground.schema.projectDirLabel",
        "placeholder": "$t:playground.schema.projectDirPlaceholder",
        "type": "input",
        "readonly": true,
        "clearable": false
      },
      {
        "name": "WEB_PORT",
        "label": "$t:playground.schema.webPortLabel",
        "type": "input",
        "placeholder": "$t:playground.schema.webPortPlaceholder",
        "clearable": true,
        "rules": [
          {
            "required": true,
            "message": "$t:playground.schema.webPortRequired"
          }
        ]
      },
      {
        "name": "VITE_PORT",
        "label": "$t:playground.schema.vitePortLabel",
        "type": "input",
        "placeholder": "$t:playground.schema.vitePortPlaceholder",
        "clearable": true,
        "rules": [
          {
            "required": true,
            "message": "$t:playground.schema.vitePortRequired"
          }
        ]
      }
    ]
  },
  {
    "id": "config-birthday",
    "label": "$t:playground.schema.tplLabelBirthday",
    "category": "config",
    "fields": [
      {
        "name": "BIRTHDAY_LIST",
        "label": "$t:playground.schema.birthdayListLabel",
        "type": "textarea",
        "placeholder": "$t:playground.schema.birthdayListPlaceholder",
        "autosize": {
          "minRows": 3,
          "maxRows": 8
        },
        "rules": [
          {
            "required": true,
            "message": "$t:playground.schema.birthdayListRequired"
          }
        ]
      },
      {
        "name": "BIRTHDAY_ADVANCE_DAYS",
        "label": "$t:playground.schema.birthdayAdvanceDaysLabel",
        "type": "select",
        "placeholder": "$t:playground.schema.birthdayAdvanceDaysPlaceholder",
        "rules": [
          {
            "required": true,
            "message": "$t:playground.schema.birthdayAdvanceDaysRequired"
          }
        ],
        "options": "$handler:config.advanceDaysOptions"
      },
      {
        "name": "BIRTHDAY_REMINDER_TIME",
        "label": "$t:playground.schema.birthdayReminderTimeLabel",
        "type": "time-picker",
        "timeFormat": "HH:mm",
        "placeholder": "$t:playground.schema.birthdayReminderTimePlaceholder",
        "rules": [
          {
            "required": true,
            "message": "$t:playground.schema.birthdayReminderTimeRequired"
          }
        ]
      },
      {
        "name": "BIRTHDAY_SEND_ON_BIRTHDAY",
        "label": "$t:playground.schema.birthdaySendOnBirthdayLabel",
        "type": "switch",
        "rules": [
          {
            "required": true,
            "message": "$t:playground.schema.birthdaySendOnBirthdayRequired"
          }
        ]
      }
    ]
  },
  {
    "id": "config-skills-map",
    "label": "$t:playground.schema.configSkillsMapLabel",
    "category": "config",
    "fields": [
      {
        "name": "SKILL_CARD_SEND_ON_WECHAT",
        "label": "$t:playground.schema.skillCardSendToWechat",
        "type": "switch",
        "rules": [
          {
            "required": true,
            "message": "$t:playground.schema.skillCardSendToWechatRequired"
          }
        ]
      },
      {
        "name": "CARD_WATERMARK",
        "label": "$t:playground.schema.cardWatermarkLabel",
        "type": "input",
        "placeholder": "$t:playground.schema.cardWatermarkPlaceholder",
        "clearable": true,
        "rules": [
          {
            "required": true,
            "message": "$t:playground.schema.cardWatermarkRequired"
          },
          {
            "max": 16,
            "message": "$t:playground.schema.cardWatermarkMax"
          }
        ]
      },
      {
        "name": "CARD_CURL_TIMEOUT",
        "label": "$t:playground.schema.cardCurlTimeoutLabel",
        "type": "input",
        "placeholder": "$t:playground.schema.cardCurlTimeoutPlaceholder",
        "help": "$t:playground.schema.cardCurlTimeoutHelp",
        "clearable": true,
        "rules": [
          {
            "required": true,
            "message": "$t:playground.schema.cardCurlTimeoutRequired"
          },
          {
            "pattern": "^[1-9][0-9]?$",
            "message": "$t:playground.schema.cardCurlTimeoutPattern"
          }
        ]
      },
      {
        "name": "CARD_TIMEZONE",
        "label": "$t:playground.schema.cardTimezoneLabel",
        "type": "select",
        "placeholder": "$t:playground.schema.cardTimezonePlaceholder",
        "clearable": false,
        "options": "$handler:config.timezoneOptions",
        "rules": [
          {
            "required": true,
            "message": "$t:playground.schema.cardTimezoneRequired"
          }
        ]
      }
    ]
  },
  {
    "id": "config-mail",
    "label": "$t:playground.schema.configMailLabel",
    "category": "config",
    "fields": [
      {
        "name": "MAIL_HOST",
        "label": "$t:playground.schema.mailHostLabel",
        "type": "input",
        "placeholder": "smtp.qq.com",
        "clearable": true,
        "rules": [
          {
            "required": true,
            "message": "$t:playground.schema.mailHostRequired"
          }
        ]
      },
      {
        "name": "MAIL_PORT",
        "label": "$t:playground.schema.mailPortLabel",
        "type": "input",
        "placeholder": "465",
        "help": "$t:playground.schema.mailPortHelp",
        "clearable": true,
        "rules": [
          {
            "required": true,
            "message": "$t:playground.schema.mailPortRequired"
          },
          {
            "pattern": "^[0-9]{2,5}$",
            "message": "$t:playground.schema.mailPortPattern"
          }
        ]
      },
      {
        "name": "MAIL_USERNAME",
        "label": "$t:playground.schema.mailUsernameLabel",
        "type": "input",
        "placeholder": "$t:playground.schema.mailUsernamePlaceholder",
        "clearable": true,
        "rules": [
          {
            "required": true,
            "message": "$t:playground.schema.mailUsernameRequired"
          }
        ]
      },
      {
        "name": "MAIL_PASSWORD",
        "label": "$t:playground.schema.mailPasswordLabel",
        "type": "input",
        "placeholder": "$t:playground.schema.mailPasswordPlaceholder",
        "help": "$t:playground.schema.mailPasswordHelp",
        "clearable": true,
        "inputType": "$handler:config.passwordToggle",
        "rules": [
          {
            "required": true,
            "message": "$t:playground.schema.mailPasswordRequired"
          }
        ]
      },
      {
        "name": "MAIL_ENCRYPTION",
        "label": "$t:playground.schema.mailEncryptionLabel",
        "type": "select",
        "placeholder": "$t:playground.schema.mailEncryptionPlaceholder",
        "clearable": false,
        "options": [
          {
            "value": "ssl",
            "label": "SSL"
          },
          {
            "value": "tls",
            "label": "TLS"
          }
        ],
        "rules": [
          {
            "required": true,
            "message": "$t:playground.schema.mailEncryptionRequired"
          }
        ]
      },
      {
        "name": "MAIL_FROM_ADDRESS",
        "label": "$t:playground.schema.mailFromAddressLabel",
        "type": "input",
        "placeholder": "$t:playground.schema.mailFromAddressPlaceholder",
        "help": "$t:playground.schema.mailFromAddressHelp",
        "clearable": true,
        "rules": [
          {
            "required": true,
            "message": "$t:playground.schema.mailFromAddressRequired"
          }
        ]
      },
      {
        "name": "MAIL_FROM_NAME",
        "label": "$t:playground.schema.mailFromNameLabel",
        "type": "input",
        "placeholder": "$t:playground.schema.mailFromNamePlaceholder",
        "clearable": true,
        "rules": [
          {
            "required": true,
            "message": "$t:playground.schema.mailFromNameRequired"
          }
        ]
      }
    ]
  },
  {
    "id": "config-ai-model",
    "label": "$t:playground.schema.aiModelFormLabel",
    "category": "config",
    "fields": [
      {
        "name": "name",
        "label": "$t:playground.schema.aiModelGroupNameLabel",
        "type": "input",
        "clearable": true,
        "rules": [
          {
            "required": true,
            "message": "$t:playground.schema.aiModelGroupNameRequired"
          }
        ]
      },
      {
        "name": "baseUrl",
        "label": "$t:playground.schema.aiModelBaseUrlLabel",
        "type": "input",
        "placeholder": "$t:playground.schema.aiModelBaseUrlPlaceholder",
        "clearable": true,
        "rules": [
          {
            "required": true,
            "message": "$t:playground.schema.aiModelBaseUrlRequired"
          }
        ]
      },
      {
        "name": "apiKey",
        "label": "$t:playground.schema.aiModelApiKeyLabel",
        "type": "input",
        "inputType": "password",
        "help": "$t:playground.schema.aiModelApiKeyHelp",
        "clearable": true,
        "rules": [
          {
            "required": true,
            "message": "$t:playground.schema.aiModelApiKeyRequired"
          }
        ]
      },
      {
        "name": "maxTokens",
        "label": "$t:playground.schema.aiModelMaxTokensLabel",
        "type": "number",
        "min": 100,
        "max": 999999,
        "step": 512,
        "theme": "normal"
      },
      {
        "name": "memoryEnabled",
        "label": "$t:playground.schema.aiMemoryEnabledLabel",
        "type": "switch",
        "help": "$t:playground.schema.aiMemoryEnabledHelp"
      },
      {
        "name": "pricingJson",
        "label": "$t:playground.schema.aiCostPricingJsonLabel",
        "type": "textarea",
        "placeholder": "$t:playground.schema.aiCostPricingJsonPlaceholder",
        "help": "$t:playground.schema.aiCostPricingJsonHelp",
        "autosize": {
          "minRows": 2,
          "maxRows": 4
        }
      }
    ]
  },
  {
    "id": "config-inspector",
    "label": "$t:playground.schema.configInspectorLabel",
    "category": "config",
    "fields": [
      {
        "name": "AI_INSPECTOR_ENABLED",
        "label": "$t:playground.schema.inspectorEnabledLabel",
        "type": "switch",
        "help": "$t:playground.schema.inspectorEnabledHelp"
      },
      {
        "name": "AI_INSPECTOR_TIME",
        "label": "$t:playground.schema.inspectorTimeLabel",
        "type": "time-picker",
        "placeholder": "$t:playground.schema.inspectorTimePlaceholder",
        "clearable": true
      },
      {
        "name": "AI_INSPECTOR_SCHEDULE",
        "label": "$t:playground.schema.inspectorScheduleLabel",
        "type": "input",
        "placeholder": "30 9 * * 1",
        "help": "$t:playground.schema.inspectorScheduleHelp",
        "clearable": true
      },
      {
        "name": "AI_INSPECTOR_PUSH",
        "label": "$t:playground.schema.inspectorPushLabel",
        "type": "switch",
        "help": "$t:playground.schema.inspectorPushHelp"
      },
      {
        "name": "AI_INSPECTOR_EMAIL",
        "label": "$t:playground.schema.inspectorEmailLabel",
        "type": "input",
        "placeholder": "$t:playground.schema.inspectorEmailPlaceholder",
        "help": "$t:playground.schema.inspectorEmailHelp",
        "clearable": true
      },
      {
        "name": "AI_INSPECTOR_CATCHUP_MINUTES",
        "label": "$t:playground.schema.inspectorCatchUpLabel",
        "type": "input",
        "placeholder": "60",
        "help": "$t:playground.schema.inspectorCatchUpHelp",
        "clearable": true,
        "rules": [
          {
            "pattern": "^[0-9]{1,3}$",
            "message": "$t:playground.schema.inspectorCatchUpPattern"
          }
        ]
      },
      {
        "name": "AI_INSPECTOR_MAX_FAILS",
        "label": "$t:playground.schema.inspectorMaxFailsLabel",
        "type": "input",
        "placeholder": "3",
        "help": "$t:playground.schema.inspectorMaxFailsHelp",
        "clearable": true,
        "rules": [
          {
            "pattern": "^[1-9]$",
            "message": "$t:playground.schema.inspectorMaxFailsPattern"
          }
        ]
