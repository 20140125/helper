# 智能提醒系统 - 环境变量配置文件示例
# 复制此文件为 .env 并填入真实的配置信息

# ===================================================
# 数据库管理（MySQL / MariaDB）
# ===================================================
# 供「数据库管理」页、全系统日志入库（hp_run_logs / hp_ai_run_traces）与业务查询使用；业务数据已完成分批迁库。
# 权限/配置/接口元数据以 hp_* 表为唯一真源（失败降级读 .cache JSON 快照）；
# 内容库/日历缓存/shell 缓存类文件仍由 shell 写入，查询走库（hp_cache_files / hp_shell_cache_files 等镜像表），按文件 mtime 自动同步。
# 迁移与校验入口：cd web && npm run migrate:cache（默认只读，--apply 才写库，--verify 校验一致性）。
# 未配置时数据库管理页提示「未配置 DB_*」，且日志只能输出到 stderr；修改后需重启 Web 服务。
# 建表脚本见 helper_database.sql（聚合入口）与 sql/（模块化 SQL）。
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=helper

# ===================================================
# 运行日志（统一入库 hp_run_logs，不写日志文件）
# ===================================================
# shell 脚本与 Web 服务共用 DB_* 连接参数写入日志；
# LOG_RETENTION_DAYS 控制过期记录保留天数，定时清理按此值删除。
LOG_RETENTION_DAYS=15

# ======================================================
# 企业微信 Webhook 配置
# ======================================================
# Webhook 地址已迁移到 Web 管理界面配置，请在界面中添加机器人
# 配置地址：http://localhost:9527 → 系统配置 → 企业微信机器人

# ===================================================
# 聚合数据 API Keys
# ===================================================

# 星座运势 API KEY
# 申请地址：https://www.juhe.cn/docs/api/id/58
# 免费版：每天50次调用
JUHE_HOROSCOPE_KEY=YOUR_HOROSCOPE_KEY_HERE

# 老黄历 API KEY
# 申请地址：https://www.juhe.cn/docs/api/id/65
# 免费版：每天50次调用
JUHE_ALMANAC_KEY=YOUR_ALMANAC_KEY_HERE

# 天气 API KEY
# 申请地址：https://www.juhe.cn/docs/api/id/73
# 免费版：每天50次调用
JUHE_WEATHER_KEY=YOUR_WEATHER_KEY_HERE

# 空气质量（WAQI）API TOKEN
# 申请地址：https://aqicn.org/data-platform/token/（免费）
# 未配置时脚本退回官方 demo token —— demo token 对任何城市都返回同一个站点
# （实测恒为上海）的数据，只有配置真实 token 才能真正按城市区分
WAQI_TOKEN=YOUR_WAQI_TOKEN_HERE

# ===================================================
# 生日提醒配置
# ===================================================

# 生日列表（格式：姓名|生日|企业微信ID，多个用分号分隔）
# 生日格式支持：
#   - MM-DD         : 公历生日（每年固定日期）
#   - YYYY-MM-DD    : 公历生日（带年份）
#   - lunar:MM-DD   : 农历生日（自动转换为当年公历日期）
#
# 示例：
#   BIRTHDAY_LIST="张三|03-15|zhangsan;李四|lunar:08-15|lisi;王五|1990-06-20|wangwu"
BIRTHDAY_LIST="张三|03-15|zhangsan;李四|lunar:08-15|lisi;王五|1990-06-20|wangwu"

# 提前提醒天数（提前N天发送生日提醒）
BIRTHDAY_ADVANCE_DAYS=1

# 是否在生日当天也发送（true/false）
BIRTHDAY_SEND_ON_BIRTHDAY=true

# 提醒时间（格式：HH:MM，24小时制）
BIRTHDAY_REMINDER_TIME="09:00"

# 城市名称
WEATHER_CITY_NAME=深圳

# 技能图片是否发送（true/false）
SKILL_CARD_SEND_ON_WECHAT=false

# 卡片右下角水印文字（不超过 16 个字符）
CARD_WATERMARK=龙哥

# 生成卡片时拉取第三方数据的超时秒数（1-99）
CARD_CURL_TIMEOUT=10

# 卡片时区（影响副标题日期、问候语等与时间相关的文案）
CARD_TIMEZONE=Asia/Shanghai

# 假期 API URL（不含年份，年份会自动追加当前年份）
HOLIDAY_API_URL=https://timor.tech/api/holiday/year

# ===================================================
# Web 管理界面配置
# ===================================================

# Web 管理界面端口（默认 9527）
WEB_PORT=9527

# Vite 端口（默认 5173）
VITE_PORT=5173

# 出站代理（可选）：服务端 fetch（模型测试、模型列表、贾维斯对话）会按这些变量走代理
# 未设置时直连；NO_PROXY 中的地址始终直连，本机回调不受影响
# HTTPS_PROXY=http://127.0.0.1:7890
# HTTP_PROXY=http://127.0.0.1:7890
# NO_PROXY=127.0.0.1,localhost,::1

# =================================================
# 邮件配置（用于 Web 管理界面登录验证码）
# =================================================

# 邮件服务器地址
MAIL_HOST=smtp.qq.com

# 邮件服务器端口
MAIL_PORT=465

# 邮件用户名（登录邮箱地址）
MAIL_USERNAME=your_email

# 邮件密码（授权码）
MAIL_PASSWORD=your_password

# 加密方式（ssl / tls）
MAIL_ENCRYPTION=ssl

# 发件人地址（同时作为接收登录验证码的目标邮箱）
MAIL_FROM_ADDRESS=your_email

# 发件人显示名称
MAIL_FROM_NAME=your_name

# 默认验证码（DEFAULT_AUTH_CODE）由系统配置页写入数据库 hp_env_config 表，不在 .env 中配置；
# 留空即关闭，仅超级管理员邮箱可用，保存后立即生效

# =================================================
# JWT 配置
# =================================================
JWT_SECRET=your_secret

# ── 主动巡检（定时让 Agent 自己巡检系统并推送简报）──
# 是否启用（true / false，默认 false）
AI_INSPECTOR_ENABLED=false
# 每日触发时间（HH:mm，默认 09:30；配置 AI_INSPECTOR_SCHEDULE 时该项失效）
AI_INSPECTOR_TIME=09:30
# cron 表达式（五段：分 时 日 月 周），用于订阅式调度，例：每周一 9:30 → 30 9 * * 1
AI_INSPECTOR_SCHEDULE=
# 是否把巡检简报推送到企微群（true / false，默认 true）
AI_INSPECTOR_PUSH=true
# 执行身份邮箱（决定工具可见范围；留空则用 MAIL_USERNAME）
AI_INSPECTOR_EMAIL=
# 补跑窗口（分钟，默认 60）：过了触发点才启动/恢复，窗口内仍补跑一次；0 = 只在当分钟触发
AI_INSPECTOR_CATCHUP_MINUTES=60
# 当日连续失败上限（默认 3）：达到后当天不再重试，避免 LLM 限流时限流式刷调用
AI_INSPECTOR_MAX_FAILS=3

# ── 外部渠道消息入口（群内 @机器人 → Agent → 推回群）──
# 调用令牌（留空则入口关闭；请求头 X-AI-Webhook-Token 需与其一致）
AI_CHAT_WEBHOOK_TOKEN=
# 该入口的执行身份邮箱（决定工具可见范围；留空用 MAIL_USERNAME）
AI_CHAT_WEBHOOK_EMAIL=
# 是否允许群消息触发副作用工具（发消息/跑脚本/启停服务），默认 false
AI_CHAT_WEBHOOK_ALLOW_SIDE_EFFECTS=false

# ── 人工审批（Human-in-the-loop）──
# 严格模式（true / false，默认 true）：开启后增删改类工具（create_rule / manage_rule /
#   update_config / manage_rbac / manage_logs / annual_update）不当场执行，先建审批单，
#   需超级管理员在 Web「AI 审批」页通过后才会真正执行。
#   数据变更必须经人工拍板，建议保持 true；确需贾维斯直接落库时才改 false 并重启。
#   推送 / 跑脚本 / 启停服务属于「动作」而非数据变更，不受此开关影响，仍按 consent 规则执行。
AI_STRICT_SIDE_EFFECTS=true

# ── 长期记忆（跨会话沉淀）──
# 是否启用每轮对话后的记忆抽取（true / false，默认 true；关闭可省一次 LLM 调用）
AI_MEMORY_ENABLED=true

# ── 成本统计（可选）──
# 按量计费模型的单价表（元/百万 token），JSON 格式；免费模型无需配置
# 例：{"glm-4.6":{"prompt":2,"completion":6}}
AI_COST_PRICING_JSON=

# ── 开发阶段：超管登录固定验证码（默认关闭，仅本地开发按需开启）──
# 开启后超管邮箱（MAIL_USERNAME）可用 123456 直接登录；生产环境务必保持 false
DEV_ADMIN_CODE_ENABLED=false
