{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": false,
    "noImplicitAny": false,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "paths": {
      "*": ["../../../../web/node_modules/*"]
    },
    "typeRoots": [
      "../../../../web/node_modules/@types"
    ],
    "types": ["node"]
  },
  "ts-node": {
    "transpileOnly": true,
    "files": true
  },
  "include": ["./**/*.ts"]
}
